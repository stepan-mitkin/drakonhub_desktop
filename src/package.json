{
  "name": "drakonhub",
  "productName": "DrakonHub",
  "version": "2026.9.10",
  "description": "A drakon flowchart and mind-map editor",
  "main": "src/main.js",

  "scripts": {
    "build:mac": "electron-builder --mac",
    "build:store": "electron-builder --win appx",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "deb": "electron-forge make --targets @electron-forge/maker-deb",
    "rpm": "electron-forge make --targets @electron-forge/maker-rpm"
  },

  "author": "Stepan Mitkin",
  "license": "Public domain",

  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^44.4.2",
    "electron-builder": "26.15.3"
  },

  "build": {
    "appId": "com.drakonhub.desktop",

    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },

    "appx": {
      "identityName": "DrakonLabs.DrakonHub",
      "publisher": "CN=9729AF8C-A583-4CB1-8066-6E376DDCF1B5",
      "publisherDisplayName": "Drakon Labs",
      "displayName": "DrakonHub"
    }
  }
}